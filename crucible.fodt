     </table:table-cell>
     <table:table-cell table:style-name="Table2.A3" office:value-type="string">
      <text:p text:style-name="P102">1<text:span text:style-name="T153">7</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A3" office:value-type="string">
      <text:p text:style-name="P108">Intelligence</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.D3" office:value-type="string">
      <text:p text:style-name="P131">20</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="TableLine94660335880224">
     <table:table-cell table:style-name="Table2.D3" table:number-columns-spanned="4" office:value-type="string">
      <text:p text:style-name="P102"/>
     </table:table-cell>
