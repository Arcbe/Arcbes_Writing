     <table:table-cell table:style-name="Table5.D3" table:number-columns-spanned="4" office:value-type="string">
      <text:p text:style-name="P105"/>
     </table:table-cell>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
     <table:covered-table-cell/>
    </table:table-row>
